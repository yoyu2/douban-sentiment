# ============================================================
# 复制本文件为 .env 并填写你自己的配置：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到 git。
# ============================================================

# ---------- 大模型 API（情感分析，必填） ----------
# 支持所有 OpenAI 兼容接口（DeepSeek / OpenAI / Moonshot / 通义千问 等），
# 修改 LLM_BASE_URL 和 LLM_MODEL 即可切换服务商。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 豆瓣登录 Cookie（可选，用于绕过反爬） ----------
DOUBAN_COOKIE=

# ---------- 后端上传地址（本机运行默认即可） ----------
UPLOAD_URL=http://127.0.0.1:8000/api/upload
